{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sprite asset set manifest",
  "type": "object",
  "required": ["schema_version", "asset_set_id", "revision", "status", "kind", "canvas", "pivot", "animations", "palette_roles"],
  "properties": {
    "schema_version": { "const": 1 },
    "asset_set_id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "accepted", "retired"] },
    "kind": { "enum": ["body", "hair", "item", "backdrop", "effect"] },
    "slot": { "enum": ["head", "face", "body", "hand", "back", "effect"] },
    "canvas": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } },
    "pivot": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } } },
    "attachments": { "type": "object", "additionalProperties": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } } } },
    "layer_order": { "type": "integer", "description": "Higher draws on top. Body 0, back -10, body-item 10, hand 20, face 30, head 40, effect 50." },
    "max_palette_colors": { "type": "integer", "default": 24 },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["frames", "frame_duration_ms", "loop"],
        "properties": {
          "frames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "frame_duration_ms": { "type": "integer", "minimum": 30 },
          "loop": { "type": "boolean" },
          "poster_frame": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "palette_roles": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } } },
    "notes": { "type": "string" }
  }
}
