  "goal_templates": [
    {
      "id": "goal.train.strength",
      "slot": "primary",
      "title": "Train strength for 30 min",
      "lines": [
        "Iron does not care how you feel. Lift anyway.",
        "Thirty minutes under load. That is the whole ask.",
        "Every set you log, I get a little heavier to knock down."
      ],
      "attribute_id": "strength",
      "rule": {
        "type": "activity_family",
        "family_id": "strength",
        "min_minutes": 30
      },
      "tags": [
        "training",
        "strength"
      ]
    },
    {
      "id": "goal.train.strength.sets",
      "slot": "primary",
      "title": "Log a workout with 12 sets",
      "lines": [
        "Twelve sets. Count them, I will.",
        "Not the longest session. The honest one."
      ],
      "attribute_id": "strength",
      "rule": {
        "type": "workout_sets",
        "count": 12
      },
      "tags": [
        "training",
        "strength"
      ]
    },
    {
      "id": "goal.train.cardio",
      "slot": "primary",
      "title": "Move for 30 min",
      "lines": [
        "Thirty minutes of breath you have to earn.",
        "Run, ride, swim. I am not picky, I am counting."
      ],
      "attribute_id": "endurance",
      "rule": {
        "type": "activity_family",
        "family_id": "cardio",
        "min_minutes": 30
      },
      "tags": [
        "training",
        "cardio"
      ]
    },
    {
      "id": "goal.train.cardio.long",
      "slot": "primary",
      "title": "Go 45 min on your feet or wheels",
      "lines": [
        "Longer today. Pace yourself; the end is where it counts.",
        "Forty-five minutes. The city is wider than it looks."
      ],
      "attribute_id": "endurance",
      "rule": {
        "type": "activity_family",
        "family_id": "cardio",
        "min_minutes": 45
      },
      "tags": [
        "training",
        "cardio"
      ]
    },
    {
      "id": "goal.train.combat",
      "slot": "primary",
      "title": "Train combat for 30 min",
      "lines": [
        "Half an hour of someone trying to hit you. Builds character, apparently.",
        "Rounds today. Keep your hands up."
      ],
      "attribute_id": "endurance",
      "rule": {
        "type": "activity_family",
        "family_id": "combat",
        "min_minutes": 30
      },
      "tags": [
        "training",
        "combat"
      ]
    },
    {
      "id": "goal.train.mobility",
      "slot": "primary",
      "title": "Yoga or stretching, 20 min",
      "lines": [
        "Twenty minutes of being kind to the joints.",
        "Range of motion is a stat too. It just does not shout."
      ],
      "attribute_id": "mindfulness",
      "rule": {
        "type": "activity_family",
        "family_id": "mobility",
        "min_minutes": 20
      },
      "tags": [
        "training",
        "mobility"
      ]
    },
    {
      "id": "goal.train.learning",
      "slot": "primary",
      "title": "Study or read for 30 min",
      "lines": [
        "Thirty minutes of the page. The gym can wait a day.",
        "Knowledge compounds. So do skipped days."
      ],
      "attribute_id": "knowledge",
      "rule": {
        "type": "activity_family",
        "family_id": "learning",
        "min_minutes": 30
      },
      "tags": [
        "training",
        "learning"
      ]
    },
    {
      "id": "goal.train.mindfulness",
      "slot": "primary",
      "title": "Sit for 15 min",
      "lines": [
        "Fifteen minutes of nothing. Harder than it sounds.",
        "Breath in, breath out, repeat until the noise drops."
      ],
      "attribute_id": "mindfulness",
      "rule": {
        "type": "activity_family",
        "family_id": "mindfulness",
        "min_minutes": 15
      },
      "tags": [
        "training",
        "mindfulness"
      ]
    },
    {
