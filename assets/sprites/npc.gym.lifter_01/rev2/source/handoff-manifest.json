    {
      "id": "bodybuilder-01",
      "label": "Mouth mask",
      "summary": "Ash crop \u00b7 dark red sweats \u00b7 kettlebell",
      "skinTone": "light tan",
      "facing": "left",
      "sprite": "bodybuilder-01-sprite.png",
      "portrait": "bodybuilder-01-portrait.png",
