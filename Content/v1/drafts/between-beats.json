    },
    {
      "id": "item.page.colossus_log.03",
      "display_name": "Log, year two",
      "description": "Old man on the Row says I spend too much time here. He looked smaller than I remembered."
    },
    {
      "id": "item.page.colossus_log.04",
      "display_name": "Log, year four",
      "description": "They put my name on the sign. Asked for it bigger."
    },
    {
      "id": "item.page.colossus_log.05",
      "display_name": "Log, year six",
      "description": "Missed six days. First time in years. Made them back."
    },
    {
      "id": "item.page.colossus_log.06",
      "display_name": "Log, year eight",
      "description": "Kid asked what I'm training for. Told him I'll know when I get there."
    },
    {
      "id": "item.page.colossus_log.07",
      "display_name": "Log, year ten",
      "description": "Couldn't remember my first program today. Added a plate."
    },
    {
      "id": "item.page.colossus_log.08",
      "display_name": "Log, year eleven",
      "description": "Someone new on the floor today. Looked at the stairs. They all do."
    }
  ],
  "story_lines": [
    {
      "goal": "goal.train.strength",
      "after": "under_city.5.gym_unlock",
      "lines": [
        "Thirty minutes under load. The Gym will still be there when you're done.",
        "Lift. Then come back. Both halves count."
      ]
    },
    {
      "goal": "goal.train.strength",
      "after": "under_city.8.reveal",
      "lines": [
        "Thirty minutes. Stronger isn't the problem. Remember that.",
        "Thirty minutes. Colossus would call that a warm-up."
      ]
    },
    {
      "goal": "goal.train.strength",
      "after": "under_city.10.resolution",
      "lines": [
        "Go train. Just come home when you're done.",
        "Thirty minutes. Then something else."
      ]
    },
    {
      "goal": "goal.rest.walk",
      "after": "quest.lower_district.rare",
      "lines": [
        "Take the long way. Tell me if you see that door again.",
        "Twenty minutes. If the door's there, don't open it. Just tell me."
      ]
    },
    {
      "goal": "goal.train.cardio.long",
      "after": "central_hill.reached",
      "lines": [
        "Forty-five minutes. And yes, I know what the Runner would say. Ignore him.",
        "Longer one. The Hill has runners who never stop. You can stop."
      ]
    }
  ],
  "rumours": [
    {
      "after": "under_city.3.protein_row",
      "text": "Someone on the Row swears the Gym's sign got bigger overnight. Nobody measured it."
    },
    {
      "after": "under_city.3.protein_row",
      "text": "Test MAX is offering a \"final formula\" again. Apparently this is the fourth one."
    },
    {
      "after": "under_city.3.protein_row",
      "text": "A courier says there's a block past the overpass that doesn't end. Couriers say a lot."
    },
    {
      "after": "under_city.3.protein_row",
      "text": "The shake stand's been there longer than the street, apparently. The old man won't say which came first."
    },
    {
      "after": "under_city.3.protein_row",
      "text": "Somebody saw the sunglasses man blink. Nobody believes them."
    },
    {
      "after": "under_city.3.protein_row",
      "text": "The rain on the Row stops for nobody. Except, people say, once."
    },
    {
      "after": "under_city.5.gym_unlock",
      "text": "Someone on the Row says the Gym never closes. The front desk says it closes every night."
    },
    {
      "after": "under_city.5.gym_unlock",
      "text": "They say the lower floor plays music. Nobody who's been down there remembers hearing it."
    },
    {
      "after": "under_city.5.gym_unlock",
      "text": "Someone ordered food to the Gym three nights in a row. Same order. Same name. Different courier each time."
    },
    {
      "after": "under_city.5.gym_unlock",
      "text": "Someone left a logbook page on the crates outside. Blank except the date. Tomorrow's."
    },
    {
      "after": "under_city.5.gym_unlock",
      "text": "The front desk doesn't keep a member list. Nobody seems bothered by this."
    },
    {
      "after": "under_city.7.deeper",
      "text": "People say Colossus hasn't left the building in a year. People also say the building's been getting bigger."
    }
  ]
}
