  "story_chapters": [
    {
      "id": "chapter.ascension_2",
      "title": "Ascension II",
      "backdrop_id": "backdrop.colossus_gym.exterior_01",
      "then": "return",
      "area_id": "under_city",
      "evolution": "ev3_evolution2",
      "beats": [
        {
          "speaker": "guide.elder",
          "lines": [
            "Again. Hold still."
          ]
        },
        {
          "speaker": "hero",
          "lines": [
            "It's brighter this time."
          ]
        },
        {
          "speaker": "guide.elder",
          "lines": [
            "It is. And it's not just your eyes now. Look down."
          ]
        },
        {
          "speaker": "guide.elder",
          "lines": [
            "The first one was the city noticing you. This one is you noticing back."
          ]
        },
        {
          "speaker": "hero",
          "lines": [
            "Does it keep going?"
          ]
        },
        {
          "speaker": "guide.elder",
          "lines": [
            "As far as you take it. That's the part nobody warns you about."
          ]
        },
        {
          "speaker": "guide.elder",
          "lines": [
            "Some of them in there have chased this for eleven years. You've been here ten days.",
            "Don't tell them."
          ]
        }
      ]
    }
  ],
  "challenges": [
    {
      "id": "challenge.cairon.strength",
      "name": "Hold the bar",
      "character_id": "guide.elder",
      "attribute_id": "strength",
      "difficulty": "standard",
      "available_from_level": 2,
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Humour an old man. There's a bar in the alley nobody can shift. Shift it.",
          "win": "Huh. Further than I ever got it.",
          "lose": "It beat me too, once. Come back heavier.",
          "aftermath_win": [
            {
              "speaker": "guide.elder",
              "lines": [
                "Don't tell anyone on the Row. They'll want to see it done again."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Would that be bad?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "Only for the bar."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "guide.elder",
              "lines": [
                "The bar's been there longer than the alley. No shame in it."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Next time."
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "That's the right answer."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.cairon.endurance",
      "name": "Keep up",
      "character_id": "guide.elder",
      "attribute_id": "endurance",
      "difficulty": "standard",
      "available_from_level": 2,
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Walk with me. I'll set the pace, you keep it. No talking.",
          "win": "You kept it. I didn't think you would.",
          "lose": "You dropped off at the overpass. The overpass gets everyone.",
          "aftermath_win": [
            {
              "speaker": "hero",
              "lines": [
                "Where were we going?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "Nowhere. That was the test."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "guide.elder",
              "lines": [
                "I walk that stretch every night. It took me a year to stop noticing it."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "How long will it take me?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "Less. You've got someone counting."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.cairon.knowledge",
      "name": "Read the signs",
      "character_id": "guide.elder",
      "attribute_id": "knowledge",
      "difficulty": "standard",
      "available_from_level": 2,
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Half the signs on the Row are wrong. Tell me which half.",
          "win": "All of them. Good. You're learning to look past the letters.",
          "lose": "You read the signs. I asked you to read the street.",
          "aftermath_win": [
            {
              "speaker": "guide.elder",
              "lines": [
                "The small signs are older. Somebody still fixes them at night."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Who?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "I was hoping you'd find out."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "hero",
              "lines": [
                "The Gym sign is the biggest one on the street."
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "It wasn't always."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "They replaced it?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "I didn't say that."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.cairon.mindfulness",
      "name": "Sit through it",
      "character_id": "guide.elder",
      "attribute_id": "mindfulness",
      "difficulty": "standard",
      "available_from_level": 2,
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Sit with me until the rain changes. Don't ask how long.",
          "win": "There. You felt it before you saw it, didn't you?",
          "lose": "You looked at the clock.",
          "aftermath_win": [
            {
              "speaker": "hero",
              "lines": [
                "The sound changed first."
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "Good."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "That's it?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "That's quite a lot."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "hero",
              "lines": [
                "How long did we sit?"
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "Long enough."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "That's not an answer."
              ]
            },
            {
              "speaker": "guide.elder",
              "lines": [
                "That's why we're doing this."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.gym.lifter.spot",
      "name": "Spot me",
      "character_id": "npc.gym.lifter",
      "attribute_id": "strength",
      "difficulty": "standard",
      "available_after_quest": "quest.colossus_gym_01",
      "area_id": "colossus_gym",
      "sets": [
        {
          "offer": "Spot me. If you can't hold it, nobody will know. I'll know.",
          "win": "You held it. Good. Again.",
          "lose": "Yeah. That's food. We'll fix that.",
          "aftermath_win": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Haven't had a spot that steady in a while."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Who spotted you before?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "..."
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Again?"
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "You're new. It'll come."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "How long did yours take?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Which part?"
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Your arms."
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Don't remember."
              ]
            }
          ]
        },
        {
          "offer": "Back again? Good. Spot me. Heavier than last time, obviously.",
          "win": "Good. We can add one.",
          "lose": "Slipped. It's fine. It's the chicken. You're not eating the chicken.",
          "aftermath_win": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "You should come every day."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "I've got somewhere to be."
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Where?"
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Home."
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "...Right."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "I'm going to write you a meal plan. It's just the word chicken, forty times."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Thanks."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.gym.lifter.last_plate",
      "name": "The last plate",
      "character_id": "npc.gym.lifter",
      "attribute_id": "strength",
      "difficulty": "hard",
      "available_after_quest": "quest.colossus_gym_02",
      "area_id": "colossus_gym",
      "sets": [
        {
          "offer": "One more plate than you can do. That's the only set that counts.",
          "win": "...You got it. Wait here.",
          "lose": "That's the one. Took me almost a year.",
          "aftermath_win": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "He would've added another."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Colossus?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Who else?"
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "You'll get it. Then there's another one. That's the good news."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "That's the good news?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "It's the only news."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.gym.lifter.floors",
      "name": "Floor to floor",
      "character_id": "npc.gym.lifter",
      "attribute_id": "endurance",
      "difficulty": "easy",
      "available_after_quest": "quest.colossus_gym_01",
      "area_id": "colossus_gym",
      "sets": [
        {
          "offer": "Race you up the floors. Lifters don't run. Don't tell anyone I asked.",
          "win": "You beat me. Again.",
          "lose": "Told you. Legs are for standing under the bar.",
          "aftermath_win": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "It's colder up here."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "It's outside."
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Right."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "You don't come out much?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "I came out today."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Don't feel bad. I've been up these stairs four thousand times. Never past the door though."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Why not?"
              ]
            },
            {
              "speaker": "npc.gym.lifter",
              "lines": [
                "Set wasn't done."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.row.courier.rain",
      "name": "Beat the rain",
      "character_id": "npc.row.courier",
      "attribute_id": "endurance",
      "difficulty": "standard",
      "available_after_milestone": "under_city.3.protein_row",
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Package for the overpass. It beats the rain or it doesn't count. You carry it.",
          "win": "Dry. Huh. Most of my packages aren't.",
          "lose": "Wet. Fine. Recipient probably is too.",
          "aftermath_win": [
            {
              "speaker": "npc.row.courier",
              "lines": [
                "You run like someone who's been somewhere."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "I don't remember where."
              ]
            },
            {
              "speaker": "npc.row.courier",
              "lines": [
                "Nobody down here does. Doesn't slow the deliveries."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.row.courier",
              "lines": [
                "Overpass gets everyone the first time. Second time you know where the puddle is."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Where is it?"
              ]
            },
            {
              "speaker": "npc.row.courier",
              "lines": [
                "Everywhere. Gotta go."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.row.courier.long_block",
      "name": "The long block",
      "character_id": "npc.row.courier",
      "attribute_id": "endurance",
      "difficulty": "hard",
      "available_after_milestone": "under_city.5.gym_unlock",
      "area_id": "under_city",
      "sets": [
        {
          "offer": "There's a block on the map that doesn't end. I need someone to find out if that's true.",
          "win": "It ends. You're the first to tell me that. I'm not sure I believe you.",
          "lose": "You came back. That's the usual result.",
          "aftermath_win": [
            {
              "speaker": "npc.row.courier",
              "lines": [
                "What's at the end?"
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "A door. Someone's name on it."
              ]
            },
            {
              "speaker": "npc.row.courier",
              "lines": [
                "...Yeah. I'm not delivering there."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.row.courier",
              "lines": [
                "I've crossed it off the map twice. It keeps coming back."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Maps don't do that."
              ]
            },
            {
              "speaker": "npc.row.courier",
              "lines": [
                "This one's old."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.row.shake_stand.who_built",
      "name": "Who built the Gym",
      "character_id": "npc.row.shake_stand",
      "attribute_id": "knowledge",
      "difficulty": "standard",
      "available_after_milestone": "under_city.4.rumors",
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Still asking who built the Gym? Fine. Tell me who you think did.",
          "win": "Close enough. Sit.",
          "lose": "That's the answer everyone gives.",
          "aftermath_win": [
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "He didn't build it. He outgrew it. The building just kept up."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Buildings don't grow."
              ]
            },
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "Drink your shake."
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "Ask me again after you've been inside."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Will the answer change?"
              ]
            },
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "You will."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "challenge.row.shake_stand.slow",
      "name": "The slow shake",
      "character_id": "npc.row.shake_stand",
      "attribute_id": "mindfulness",
      "difficulty": "easy",
      "available_after_milestone": "under_city.4.rumors",
      "area_id": "under_city",
      "sets": [
        {
          "offer": "Drink this slowly. The whole thing. If you check the time, you've lost.",
          "win": "Didn't look once. Good.",
          "lose": "You looked. Twice. The shake's still fine.",
          "aftermath_win": [
            {
              "speaker": "hero",
              "lines": [
                "What did you put in this?"
              ]
            },
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "Banana."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "That's it?"
              ]
            },
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "What were you expecting?"
              ]
            }
          ],
          "aftermath_lose": [
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "He used to drink one every morning. Standing. Watching the door."
              ]
            },
            {
              "speaker": "hero",
              "lines": [
                "Watching for what?"
              ]
            },
            {
              "speaker": "npc.row.shake_stand",
              "lines": [
                "Someone bigger. Nobody came."
              ]
            }
          ]
        }
      ]
    }
  ],
